# Copy to .env and fill in your own values:  cp .env.example .env
#
# Nothing here has a project-specific default. Where a value has no safe
# default the code raises a named RuntimeError at startup rather than falling
# back to a placeholder -- a placeholder default surfaces much later as a
# confusing BigQuery 404 in whichever query happens to run first.
#
# .env is gitignored. Never commit a filled-in copy.
#
# Nothing loads this file automatically -- there is no dotenv dependency.
# Export it into the shell you run the scripts from:
#
#     set -a && . ./.env && set +a
#
# See "Set these before you deploy" in docs/RECREATE.md for what each
# variable does and what breaks when it is missing.

# ---- Required ----------------------------------------------------------

# Your GCP project ID, e.g. my-mining-demo-1234
GOOGLE_CLOUD_PROJECT=

# The numeric project number for the same project. Find it with:
#   gcloud projects describe "$GOOGLE_CLOUD_PROJECT" --format='value(projectNumber)'
GOOGLE_CLOUD_PROJECT_NUMBER=

# GCS bucket Vertex AI Agent Engine stages packaged agents through. Must
# already exist and be writable by you -- Agent Engine does not create it:
#   gcloud storage buckets create gs://YOUR-BUCKET --location=us-central1
VERTEX_STAGING_BUCKET=gs://

# GCS bucket serving the showcase recordings.
VIDEO_BUCKET=

# ---- Optional (defaults shown) -----------------------------------------

# BigQuery dataset holding the mining tables.
# MINING_DATASET=mining_data

# BigQuery dataset location.
# MINING_LOCATION=US

# Region for Cloud Run and Agent Engine resources. Note that model calls go to
# the `global` endpoint regardless -- the tiered models are published only
# there, and a regional client returns 404 in language that reads like a
# missing grant rather than a location mismatch.
# MINING_REGION=us-central1

# BigQuery CLOUD_RESOURCE connection used by the remote embedding model.
# BQ_CONNECTION_ID=gemini-connection

# Runtime identity for registered agents. Defaults to
# mag-agent-coordinator@${GOOGLE_CLOUD_PROJECT}.iam.gserviceaccount.com
# ENGINE_SERVICE_ACCOUNT=

# Path to the bq CLI if it is not on your PATH.
# BQ_BINARY=
